# Copy to .env for local dev. Railway: set these as service variables.
ENV=dev

# Local default: postgres via `docker compose up -d db` (port 55442).
# Production: Supavisor transaction pooler URL, port 6543 — NOT the direct connection.
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# SUPABASE_URL=https://<project-ref>.supabase.co
# CORS_ORIGINS=[]

# SCHEDULER_ENABLED=true

# Affiliate ids for the generated buy links (services/buy_links.py). Unset =
# links render untagged and earn nothing. Not credentials — plain URL params.
# AMAZON_ASSOCIATE_TAG=kitabi0b-21
# Flipkart: its DIRECT programme is closed to new publishers, so FLIPKART_AFFILIATE_ID
# (the legacy affid=) is only for an account that already has direct access. The
# reachable route is Cuelinks, which tracks by owning the redirect rather than by a
# parameter — set CUELINKS_CID and the generated Flipkart link is wrapped in their
# Link Kit URL. Direct wins over the aggregator if both are set.
# FLIPKART_AFFILIATE_ID=
# CUELINKS_CID=12345
